# Deployment Configuration
PRIVATE_KEY=0xyour_private_key_with_0x_prefix

# Network Configuration (choose: celo-mainnet or celo-sepolia)
# if you're using celo-sepolia, please run `foundyup --install 0.3.0`
NETWORK=celo-sepolia

# Hub Address (auto-set based on NETWORK, override only if needed)
# Celo Sepolia: 0x16ECBA51e18a4a7e61fdC417f0d47AFEeDfbed74
# Celo Mainnet: 0xe57F4773bd9c9d8b6Cd70431117d353298B9f5BF
IDENTITY_VERIFICATION_HUB_ADDRESS=0x16ECBA51e18a4a7e61fdC417f0d47AFEeDfbed74

# Block Explorer API Keys (optional, for contract verification)
CELOSCAN_API_KEY=your_celoscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# Scope Seed for Scope Calculation
SCOPE_SEED="self-workshop"

# ─── LayerZero Cross-Chain Configuration ─────────────────────────────────────
# Required for deploy-oapp-cross-chain.sh
VERIFICATION_CONFIG_ID=0xc52f992ebee4435b00b65d2c74b12435e96359d1ccf408041528414e6ea687bc
DESTINATION_EID=30184                 # Base Mainnet EID
BASE_MAINNET_LZ_ENDPOINT_ADDRESS=0x1a44076050125825900e736c501f859c50fE728c

# Deployment Automation (optional)
AUTO_SETUP_PEERS=true          # Automatically configure LayerZero peers
AUTO_FUND_SOURCE=false         # Automatically fund source contract with CELO
FUND_AMOUNT="0.01"             # Amount in CELO to fund source contract
VERIFY_CONTRACTS=false         # Verify contracts on block explorers

# Network Information (for reference)
# Source Chain: Celo Mainnet (LayerZero EID: 30125)
#   - Hub Address: 0xe57F4773bd9c9d8b6Cd70431117d353298B9f5BF
#   - LZ Endpoint: 0x1a44076050125825900e736c501f859c50fE728c
# Destination Chain: Base Mainnet (LayerZero EID: 30184)
#   - LZ Endpoint: 0x1a44076050125825900e736c501f859c50fE728c